---
// Página do GM IDE Android. É independente da Astra: não usa o layout do
// Starlight, os tokens do portal nem o mascote. O APK continua nas Releases do
// GitHub; esta página só apresenta e redireciona. Os valores abaixo são o
// fallback sem JavaScript; o script atualiza versão, tamanho e hash pela API.
import release from '../../../data/gm-release.json';
const repo = 'https://github.com/kacerato/gamemaker-ide-android';
const latest = `${repo}/releases/latest`;
const fallback = {
  version: release.version,
  title: release.title,
  size: `${Math.round(release.bytes / 1e6)} MB`,
  date: release.date.split('-').reverse().join('/'),
  sha256: release.sha256,
};
const favicon = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#0B2A3F"/><path d="M14 20h36M14 32h24M14 44h30" stroke="#7DD3FC" stroke-width="6" stroke-linecap="round"/></svg>')}`;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GM IDE Android — baixar</title>
  <meta name="description" content="Port pessoal da IDE do GameMaker para Android ARM64: editar, testar com F5 e exportar APK, Web e Windows pelo celular." />
  <meta name="theme-color" content="#7DD3FC" />
  <link rel="icon" href={favicon} />
  <link rel="canonical" href="https://astraengine.com.br/gm/" />
  <style is:global>
    :root {
      --sky: #7DD3FC;
      --sky-strong: #38BDF8;
      --sky-soft: #E0F2FE;
      --ink: #0B2A3F;
      --ink-2: #33536A;
      --paper: #EEF8FF;
      --card: #FFFFFF;
      --line: #C6E2F5;
      --btn-ink: #062033;
      --warn: #8A4B00;
      --warn-bg: #FFF4E0;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0; background: var(--paper); color: var(--ink);
      font: 17px/1.6 "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
    }
    a { color: inherit; }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--sky-strong); outline-offset: 3px; border-radius: 6px; }
    code, .mono { font-family: "Cascadia Code", Consolas, ui-monospace, monospace; font-size: .86em; }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }

    .bar { border-bottom: 1px solid var(--line); background: var(--sky-soft); }
    .bar .wrap { display: flex; align-items: center; gap: 16px; min-height: 64px; }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; text-decoration: none; letter-spacing: -.01em; }
    .brand svg { flex: none; }
    .bar nav { margin-left: auto; display: flex; gap: 20px; font-size: .9rem; }
    .bar nav a { text-decoration: none; color: var(--ink-2); padding: 10px 0; }
    .bar nav a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; }

    .hero { padding: 56px 0 48px; background: linear-gradient(180deg, var(--sky-soft), var(--paper)); }
    .hero .wrap { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 48px; align-items: start; }
    .tag { display: inline-block; font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 14px; }
    h1 { font-size: clamp(2.1rem, 5vw, 3.3rem); line-height: 1.08; letter-spacing: -.025em; margin: 0 0 18px; font-weight: 800; }
    h1 mark { background: linear-gradient(transparent 62%, var(--sky) 62%); color: inherit; padding: 0 .06em; }
    .lead { font-size: 1.12rem; color: var(--ink-2); max-width: 34em; margin: 0 0 28px; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .btn {
      display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 24px;
      border-radius: 10px; font-weight: 800; text-decoration: none; font-size: 1.02rem;
    }
    .btn-main { background: var(--sky); color: var(--btn-ink); box-shadow: 0 4px 0 var(--sky-strong); }
    .btn-main:hover { background: #A5E1FD; }
    .btn-main:active { transform: translateY(2px); box-shadow: 0 2px 0 var(--sky-strong); }
    .btn-ghost { border: 1.5px solid var(--line); color: var(--ink); }
    .btn-ghost:hover { border-color: var(--sky-strong); }
    .note { font-size: .88rem; color: var(--ink-2); margin: 14px 0 0; }

    .spec { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 22px 24px; }
    .spec h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-2); margin: 0 0 6px; }
    .spec .ver { font-size: 1.5rem; font-weight: 800; margin: 0; letter-spacing: -.01em; }
    .spec .sub { margin: 0 0 14px; color: var(--ink-2); font-size: .95rem; }
    .spec dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; font-size: .94rem; }
    .spec dt { color: var(--ink-2); }
    .spec dd { margin: 0; font-weight: 600; }
    .hash { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); font-size: .82rem; color: var(--ink-2); }
    .hash code { display: block; word-break: break-all; color: var(--ink); margin-top: 4px; font-size: .78rem; }

    section.block { padding: 44px 0; border-top: 1px solid var(--line); }
    section.block h2 { font-size: 1.55rem; letter-spacing: -.015em; margin: 0 0 8px; }
    section.block > .wrap > p.intro { color: var(--ink-2); margin: 0 0 24px; max-width: 40em; }

    ol.steps { list-style: none; counter-reset: s; padding: 0; margin: 0; display: grid; gap: 14px; max-width: 760px; }
    ol.steps li { counter-increment: s; position: relative; padding: 2px 0 2px 52px; }
    ol.steps li::before {
      content: counter(s); position: absolute; left: 0; top: 0; width: 34px; height: 34px; border-radius: 50%;
      background: var(--sky-soft); color: var(--ink); font-weight: 800; display: grid; place-items: center; font-size: .95rem;
      border: 1.5px solid var(--sky);
    }
    ol.steps strong { display: block; }
    ol.steps span { color: var(--ink-2); }

    .callout { margin-top: 26px; max-width: 760px; background: var(--warn-bg); color: var(--warn); border-radius: 12px; padding: 14px 18px; font-size: .95rem; }
    .callout strong { color: inherit; }

    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
    .cols h3 { font-size: 1.05rem; margin: 0 0 10px; }
    ul.list { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
    ul.list li { padding-left: 26px; position: relative; }
    ul.list li::before { content: ""; position: absolute; left: 4px; top: .62em; width: 9px; height: 9px; border-radius: 2px; background: var(--sky-strong); }
    ul.list.no li::before { background: transparent; border: 1.5px solid var(--ink-2); }
    ul.list small { display: block; color: var(--ink-2); font-size: .88rem; }

    footer { border-top: 1px solid var(--line); padding: 28px 0 40px; font-size: .86rem; color: var(--ink-2); }
    footer p { margin: 0 0 8px; max-width: 52em; }

    @media (max-width: 820px) {
      .hero { padding: 36px 0 32px; }
      .hero .wrap, .cols { grid-template-columns: 1fr; gap: 28px; }
      .bar nav a.opt { display: none; }
      .btn { width: 100%; justify-content: center; }
    }
    @media (prefers-reduced-motion: reduce) { .btn-main:active { transform: none; } }
  </style>
</head>
<body>
  <header class="bar">
    <div class="wrap">
      <a class="brand" href="/gm/" aria-label="GM IDE Android — início">
        <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0B2A3F"/><path d="M14 20h36M14 32h24M14 44h30" stroke="#7DD3FC" stroke-width="6" stroke-linecap="round"/></svg>
        GM IDE Android
      </a>
      <nav aria-label="Links">
        <a href="#instalar">Instalar</a>
        <a class="opt" href={`${repo}/releases`}>Todas as versões</a>
        <a href="/">Astra Docs</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div>
          <p class="tag">Android · ARM64 · port pessoal</p>
          <h1>A IDE do GameMaker <mark>no celular</mark>.</h1>
          <p class="lead">Abra projetos, edite com toque ou teclado, teste com F5 no próprio aparelho e exporte APK, Web e Windows sem um computador.</p>
          <div class="actions">
            <a class="btn btn-main" id="gm-download" href={release.downloadUrl}>
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
              Baixar APK
            </a>
            <a class="btn btn-ghost" id="gm-notes" href={release.releaseUrl}>Notas da versão</a>
          </div>
          <p class="note">Download direto do APK no GitHub. IDE e runtime já vêm dentro dele. <a href={release.checksumUrl}>Conferir SHA-256</a>.</p>
        </div>

        <aside class="spec" aria-labelledby="spec-h">
          <h2 id="spec-h">Versão atual</h2>
          <p class="ver" id="gm-version">{fallback.version}</p>
          <p class="sub" id="gm-title">{fallback.title} · <span id="gm-date">{fallback.date}</span></p>
          <dl>
            <dt>Tamanho</dt><dd id="gm-size">≈ {fallback.size}</dd>
            <dt>Aparelho</dt><dd>Android ARM64</dd>
            <dt>Preview (F5)</dt><dd>Android 11 ou superior</dd>
            <dt>Espaço livre</dt><dd>≈ 1 GB além do APK</dd>
          </dl>
          <div class="hash">SHA-256 do APK<code id="gm-sha">{fallback.sha256}</code></div>
        </aside>
      </div>
    </section>

    <section class="block" id="instalar">
      <div class="wrap">
        <h2>Instalar</h2>
        <p class="intro">A primeira abertura prepara a IDE e o runtime a partir do próprio APK, sem internet e sem escolher um ZIP.</p>
        <ol class="steps">
          <li><strong>Baixe o APK</strong><span>Em <a href={latest}>Releases</a>, toque em <code>gmide-android-….apk</code> na lista de arquivos.</span></li>
          <li><strong>Permita a instalação</strong><span>Quando o Android pedir, autorize o navegador ou o gerenciador de arquivos a instalar apps.</span></li>
          <li><strong>Abra e aguarde a preparação</strong><span>O app extrai a IDE e o runtime na primeira vez. Deixe a tela aberta até terminar.</span></li>
          <li><strong>Abra ou crie um projeto</strong><span>Use F5 para testar e Exportar para gerar APK, Web ou Windows. Permita o acesso aos arquivos quando for abrir ou salvar.</span></li>
        </ol>
        <div class="callout"><strong>Atualizando?</strong> Instale o APK novo por cima do atual. Não desinstale nem limpe os dados: projetos e arquivos são preservados, porque a assinatura é a mesma.</div>
      </div>
    </section>

    <section class="block">
      <div class="wrap">
        <h2>O que dá para fazer</h2>
        <p class="intro">O exportador roda no celular. As validações de cada versão estão nas notas da Release.</p>
        <div class="cols">
          <div>
            <h3>Funciona</h3>
            <ul class="list">
              <li>Editar projetos com toque, teclado e atalhos<small>Barra de atalhos e gestos adaptados à tela.</small></li>
              <li>Testar com F5 no aparelho<small>Preview local Android VM, a partir do Android 11.</small></li>
              <li>Exportar APK Android VM<small>Assinado no próprio celular.</small></li>
              <li>Exportar Web e Windows<small>ZIP WebAssembly e um único EXE Windows x64 baseado em WebView2. Os arquivos do jogo ficam embutidos; a extração é automática.</small></li>
              <li>Diagnóstico opcional de uso e falhas<small>O envio depende da sua escolha no app. Você pode desligar em ⋯ → Dados de uso e falhas.</small></li>
            </ul>
          </div>
          <div>
            <h3>Ainda não</h3>
            <ul class="list no">
              <li>YYC e AAB</li>
              <li>Windows VM nativo</li>
              <li>Aparelhos 32 bits ou x86</li>
              <li>Extensões Java/Kotlin fora do modelo do runner</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <p>GM IDE Android é um port pessoal, sem vínculo com a YoYo Games ou a Opera. Ele não substitui a licença nem os termos do GameMaker: use a sua própria conta.</p>
      <p><a href={repo}>Código e documentação no GitHub</a> · <a href={`${repo}/releases`}>Todas as versões</a> · <a href="/">Astra Docs</a></p>
    </div>
  </footer>

  <script is:inline>
    // Atualiza a ficha com a Release mais recente. Sem rede ou sem JS, a página
    // continua com os valores escritos e o botão leva à Release mais recente.
    (async () => {
      try {
        const r = await fetch('https://api.github.com/repos/kacerato/gamemaker-ide-android/releases/latest', { headers: { Accept: 'application/vnd.github+json' } });
        if (!r.ok) return;
        const rel = await r.json();
        const apk = (rel.assets || []).find(a => /\.apk$/i.test(a.name));
        const set = (id, v) => { const el = document.getElementById(id); if (el && v) el.textContent = v; };
        const m = /(\d+\.\d+(?:\.\d+)?)\s*[-–—]\s*(.+)$/.exec(rel.name || '');
        if (m) { set('gm-version', m[1]); set('gm-title', m[2]); }
        if (rel.published_at) {
          const d = new Date(rel.published_at).toLocaleDateString('pt-BR');
          const t = document.getElementById('gm-title');
          if (t) { t.append(' · '); const s = document.createElement('span'); s.textContent = d; t.append(s); }
        }
        if (rel.html_url) document.getElementById('gm-notes').href = rel.html_url;
        if (apk) {
          const url = new URL(apk.browser_download_url || '');
          if (url.origin === 'https://github.com' && url.pathname.startsWith('/kacerato/gamemaker-ide-android/releases/download/')) document.getElementById('gm-download').href = url.href;
          set('gm-size', '≈ ' + Math.round(apk.size / 1e6) + ' MB');
          if (apk.digest && apk.digest.startsWith('sha256:')) set('gm-sha', apk.digest.slice(7));
        }
      } catch {}
    })();
  </script>
</body>
</html>
