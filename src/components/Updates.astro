---
import { updates, kindLabels } from '../../tools/updates.mjs';
import UpdateEntry from './UpdateEntry.astro';
// Agrupa pela publicação: cada APK traz as notas anteriores a ele até o APK de antes.
// As notas vêm da mais nova para a mais velha; nenhuma é alterada, só a apresentação.
const isRelease = e => e.kind === 'release' && e.availability === 'distributed';
const groups = [{ release: null, published: [], development: [] }];
for (const e of updates.entries) {
  if (isRelease(e)) { groups.push({ release: e, published: [], development: [] }); continue; }
  const g = groups[groups.length - 1];
  (e.availability === 'development' ? g.development : g.published).push(e);
}
const versionOf = e => e.releaseVersion.replace(/-preview\..*/, '');
const dateLabel = d => d.split('-').reverse().join('/');
const kinds = ['feature', 'improvement', 'fix', 'release'];
const pending = groups[0];
---
<section class="astra-updates" aria-label="Histórico de atualizações">
  <p>Cada versão publicada abre com a nota da publicação, que diz o que entrou nela. As revisões de desenvolvimento do período até essa versão ficam recolhidas: nem toda revisão de desenvolvimento chegou ao APK; confira a nota da publicação.</p>
  <div class="updates-tools">
    <fieldset><legend>Origem</legend><label><input type="radio" name="updates-scope" value="all" checked /> Tudo</label><label><input type="radio" name="updates-scope" value="app" /> App</label><label><input type="radio" name="updates-scope" value="docs" /> Docs</label></fieldset>
    <fieldset><legend>Tipo</legend><label><input type="radio" name="updates-kind" value="all" checked /> Todos</label>{kinds.map(k => <label><input type="radio" name="updates-kind" value={k} /> {kindLabels[k]}</label>)}</fieldset>
    <label class="updates-search">Buscar no histórico<input id="updates-query" type="search" placeholder="Recurso, versão ou correção" autocomplete="off" /></label>
  </div>
  <p id="updates-count" role="status" aria-live="polite">{updates.entries.length} atualizações</p>
  <p class="updates-empty" hidden>Nenhuma atualização corresponde à busca. <button type="button" data-updates-reset>Limpar filtros</button></p>
  <nav class="updates-versions" aria-label="Versões">{groups.slice(1).map(g => <a href={`#versao-${g.release.versionCode}`}>{versionOf(g.release)}</a>)}</nav>
  <div class="updates-history">
    {(pending.published.length + pending.development.length) > 0 && <section class="updates-group" data-group>
      <h2 class="updates-group-title">Desde a última versão <span>docs já publicadas; mudanças do app ainda não estão no APK público</span></h2>
      {pending.published.map(e => <UpdateEntry e={e} />)}
      {pending.development.length > 0 && <details class="updates-dev"><summary>Revisões de desenvolvimento deste período ({pending.development.length})</summary>
        {pending.development.map(e => <UpdateEntry e={e} />)}
      </details>}
    </section>}
    {groups.slice(1).map(g => <section class="updates-group" id={`versao-${g.release.versionCode}`} data-group>
      <h2 class="updates-group-title">Astra {versionOf(g.release)} <span>{dateLabel(g.release.date)} · versionCode {g.release.versionCode}</span></h2>
      {[g.release, ...g.published].map(e => <UpdateEntry e={e} />)}
      {g.development.length > 0 && <details class="updates-dev"><summary>Revisões de desenvolvimento deste período ({g.development.length})</summary>
        {g.development.map(e => <UpdateEntry e={e} />)}
      </details>}
    </section>)}
  </div>
  <p class="updates-formats"><a href="/download/">Download da versão pública</a> · <a href="/updates/feed.json">Feed JSON</a> · <a href="/markdown/atualizacoes.md">Histórico em Markdown</a></p>
</section>
<script>
  const root = document.querySelector('.astra-updates');
  if (root) {
    const query = root.querySelector<HTMLInputElement>('#updates-query')!;
    const articles = [...root.querySelectorAll<HTMLElement>('article[data-scopes]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const dev = [...root.querySelectorAll<HTMLDetailsElement>('details.updates-dev')];
    const filter = () => {
      const scope = root.querySelector<HTMLInputElement>('input[name="updates-scope"]:checked')!.value;
      const kind = root.querySelector<HTMLInputElement>('input[name="updates-kind"]:checked')!.value;
      const normalize = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLocaleLowerCase('pt-BR');
      const term = normalize(query.value.trim());
      let count = 0;
      for (const row of articles) {
        row.hidden = !(scope === 'all' || row.dataset.scopes!.split(' ').includes(scope)) || !(kind === 'all' || row.dataset.kind === kind) || !normalize(row.dataset.updateSearch!).includes(term);
        if (!row.hidden) ++count;
      }
      for (const g of groups) g.hidden = !g.querySelector('article:not([hidden])');
      // Com busca ou filtro, abre o histórico que tem resultado; sem filtro, volta a recolher.
      const filtering = term !== '' || kind !== 'all' || scope !== 'all';
      for (const d of dev) { const any = !!d.querySelector('article:not([hidden])'); d.hidden = !any; d.open = filtering && any; }
      root.querySelector('#updates-count')!.textContent = `${count} ${count === 1 ? 'atualização' : 'atualizações'}`;
      (root.querySelector('.updates-empty') as HTMLElement).hidden = count !== 0;
    };
    const reveal = () => {
      const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      const holder = target?.closest('details.updates-dev') as HTMLDetailsElement | null;
      if (holder && !holder.open) { holder.open = true; target!.scrollIntoView(); }
    };
    query.addEventListener('input', filter);
    root.querySelectorAll('input[name="updates-scope"],input[name="updates-kind"]').forEach(el => el.addEventListener('change', filter));
    root.querySelector('[data-updates-reset]')!.addEventListener('click', () => { query.value = ''; root.querySelectorAll<HTMLInputElement>('input[value="all"]').forEach(i => i.checked = true); filter(); query.focus(); });
    window.addEventListener('hashchange', reveal); reveal();
  }
</script>
<style is:global>
.astra-updates .updates-tools { display:flex; gap:1rem 2rem; flex-wrap:wrap; align-items:end; margin:1rem 0; }
.astra-updates fieldset { border:0; padding:0; margin:0; } .astra-updates legend, .astra-updates .updates-search { font-weight:600; font-size:.88rem; }
.astra-updates fieldset label { display:inline-flex; align-items:center; gap:.4rem; min-height:44px; margin-right:1.1rem; cursor:pointer; }
.astra-updates input { font:inherit; accent-color:var(--sl-color-accent-high); } .astra-updates input[type=search] { display:block; width:100%; margin-top:.5rem; padding:.65rem; border:1px solid var(--sl-color-gray-4); background:var(--sl-color-bg); color:var(--sl-color-white); border-radius:0; }
.astra-updates .updates-search { flex:1; min-width:200px; } .astra-updates #updates-count { color:var(--sl-color-gray-2); font-size:.88rem; }
.astra-updates .updates-versions { display:flex; flex-wrap:wrap; gap:.5rem 1.2rem; margin:.5rem 0 1rem; font-size:.9rem; }
.astra-updates .updates-group { margin-top:2.5rem; scroll-margin-top:6rem; }
.astra-updates .updates-group-title { font-size:1.6rem; border-bottom:2px solid var(--sl-color-accent-high); padding-bottom:.5rem; }
.astra-updates .updates-group-title span { display:block; font-size:.85rem; font-weight:400; color:var(--sl-color-gray-2); margin-top:.3rem; }
.astra-updates article { border-top:1px solid var(--sl-color-gray-4); padding:1.8rem 0 2.1rem; scroll-margin-top:6rem; }
.astra-updates .updates-group > article:first-of-type { border-top:0; }
.astra-updates .updates-meta { display:flex; flex-wrap:wrap; gap:.5rem 1.2rem; font-size:.83rem; color:var(--sl-color-gray-2); }
.astra-updates article h3 { margin:.7rem 0 .5rem; font-size:1.3rem; line-height:1.3; } .astra-updates article h3 a { color:inherit; text-decoration:none; } .astra-updates article h3 a:hover { text-decoration:underline; } .astra-updates .updates-version { font-size:.83rem; color:var(--sl-color-gray-2); }
.astra-updates article nav { display:flex; flex-wrap:wrap; gap:.65rem 1.4rem; margin-top:1rem; } .astra-updates article details { margin-top:1rem; } .astra-updates summary { cursor:pointer; padding:.5rem 0; font-weight:600; } .astra-updates li { margin-top:.5rem; }
.astra-updates .updates-dev { border:1px solid var(--sl-color-gray-5); padding:.2rem 1rem; margin-top:1rem; }
.astra-updates .updates-dev > summary { min-height:44px; display:flex; align-items:center; }
.astra-updates .updates-formats { border-top:1px solid var(--sl-color-gray-4); padding-top:1.5rem; font-size:.9rem; }
.astra-updates button { font:inherit; color:inherit; background:none; border:0; text-decoration:underline; padding:.6rem; cursor:pointer; }
.astra-updates :is(input,summary,a,button):focus-visible { outline:3px solid var(--sl-color-accent-high); outline-offset:4px; }
  @media(max-width:500px) { .astra-updates .updates-tools { gap:1rem; } .astra-updates .updates-search { width:100%; } .astra-updates .updates-meta { gap:.35rem .9rem; }  }
</style>
